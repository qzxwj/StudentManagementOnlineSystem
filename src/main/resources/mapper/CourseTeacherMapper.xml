<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.studentmanagementonlinesystem.mapper.CourseTeacherMapper">
    <select id="findBySearch" resultType="CourseTeacher">
        SELECT * FROM ct
        <where>
            <if test="cid != null">
                cid = #{cid}
            </if>
            <if test="tid != null">
                AND tid = #{tid}
            </if>
        </where>
    </select>

    <select id="findCourseTeacherInfo" resultType="CourseTeacherInfo">
        SELECT c.cid, c.cname, t.tid, t.tname, c.ccredit
        FROM c c INNER JOIN ct ct ON c.cid = ct.cid
                INNER JOIN t t ON ct.tid = t.tid
        <where>
            <if test="tid != null">
                t.tid = #{tid}
            </if>
            <if test="tname != null">
                <if test="tFuzzy == 0">
                    AND t.tname = #{tname}
                </if>
                <if test="tFuzzy == 1">
                    AND t.tname LIKE CONCAT('%', #{tname}, '%')
                </if>
            </if>
            <if test="cid != null">
                AND c.cid = #{cid}
            </if>
            <if test="cname != null">
                <if test="cFuzzy == 0">
                    AND c.cname = #{cname}
                </if>
                <if test="cFuzzy == 1">
                    AND c.cname LIKE CONCAT('%', #{cname}, '%')
                </if>
            </if>
        </where>
    </select>
</mapper>
