<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.studentmanagementonlinesystem.mapper.TeacherMapper">
    <select id="findAll" resultType="Teacher">
        select tid, tname, password
        from t
    </select>

    <select id="findById" resultType="Teacher">
        select tid, tname, password
        from t
        where tid = #{tid}
    </select>

    <select id="findBySearch" resultType="Teacher">
        select tid, tname, password
        from t
        <where>
            <if test="tid != null">
                and tid = #{tid}
            </if>
            <if test="tname != null and tname != ''">
                <choose>
                    <when test="fuzzy != null and fuzzy == 1">
                        and tname like concat('%', #{tname}, '%')
                    </when>
                    <otherwise>
                        and tname = #{tname}
                    </otherwise>
                </choose>
            </if>
        </where>
    </select>

    <update id="updateById">
        update t
        <set>
            <if test="teacher.tname != null and teacher.tname != ''">
                tname = #{teacher.tname},
            </if>
            <if test="teacher.password != null and teacher.password != ''">
                password = #{teacher.password},
            </if>
        </set>
        where tid = #{teacher.tid}
    </update>

    <insert id="save">
        insert into t (tid, tname, password)
        values (#{teacher.tid}, #{teacher.tname}, #{teacher.password})
    </insert>

    <insert id="register" useGeneratedKeys="true" keyProperty="teacher.tid">
        insert into t (tname, password)
        values (#{teacher.tname}, #{teacher.password})
    </insert>

    <delete id="deleteById">
        delete from t
        where tid = #{tid}
    </delete>
</mapper>
